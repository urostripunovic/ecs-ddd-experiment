{
  "name": "ddd-ecs-arena",
  "version": "1.0.0",
  "description": "Greybox three.js arena on a hand-written ECS with a thin typed DDD layer",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint:deps": "depcruise src --config .dependency-cruiser.cjs",
    "check": "npm run typecheck && npm test && npm run lint:deps"
  },
  "author": "Uros Tripunovic",
  "license": "MIT",
  "dependencies": {
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/three": "^0.186.0",
    "dependency-cruiser": "^18.6.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "private": true,
  "type": "module"
}
